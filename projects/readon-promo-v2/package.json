{
  "name": "readon-promo-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "capture": "node scripts/capture.mjs",
    "generate:sfx": "node scripts/generate-sfx.mjs",
    "fetch:voice": "node scripts/fetch-voice.mjs",
    "typecheck": "tsc --noEmit",
    "render": "remotion render src/index.ts ReadonPromoV2 out/readon-promo-v2.mp4 --codec=h264 --crf=16 --concurrency=1",
    "still:01": "remotion still src/index.ts ReadonPromoV2 out/01-pain.png --frame=62 --scale=0.5",
    "still:02": "remotion still src/index.ts ReadonPromoV2 out/02-reveal.png --frame=145 --scale=0.5",
    "still:03": "remotion still src/index.ts ReadonPromoV2 out/03-topic.png --frame=220 --scale=0.5",
    "still:04": "remotion still src/index.ts ReadonPromoV2 out/04-controls.png --frame=330 --scale=0.5",
    "still:05": "remotion still src/index.ts ReadonPromoV2 out/05-reader.png --frame=490 --scale=0.5",
    "still:06": "remotion still src/index.ts ReadonPromoV2 out/06-translation.png --frame=585 --scale=0.5",
    "still:07": "remotion still src/index.ts ReadonPromoV2 out/07-explanation.png --frame=680 --scale=0.5",
    "still:08": "remotion still src/index.ts ReadonPromoV2 out/08-montage.png --frame=750 --scale=0.5",
    "still:09": "remotion still src/index.ts ReadonPromoV2 out/09-outro.png --frame=845 --scale=0.5",
    "stills": "npm run still:01 && npm run still:02 && npm run still:03 && npm run still:04 && npm run still:05 && npm run still:06 && npm run still:07 && npm run still:08 && npm run still:09"
  },
  "dependencies": {
    "@remotion/cli": "4.0.526",
    "@remotion/media": "4.0.526",
    "playwright": "1.55.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.526"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "5.8.2"
  }
}
