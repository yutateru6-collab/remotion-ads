{
  "name": "readon-promo-v5",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "scripts": {
    "capture": "node scripts/capture.mjs",
    "fetch:voice": "node scripts/fetch-voice.mjs",
    "generate:sfx": "node scripts/generate-sfx.mjs",
    "audio:sync": "node scripts/check-audio-sync.mjs",
    "typecheck": "tsc --noEmit",
    "render:raw": "remotion render src/index.ts ReadonPromoV5 out/readon-promo-v5-raw.mp4 --codec=h264 --crf=16 --concurrency=1",
    "still:01": "remotion still src/index.ts ReadonPromoV5 out/01-hook.png --frame=24 --scale=0.5",
    "still:02": "remotion still src/index.ts ReadonPromoV5 out/02-quiz.png --frame=66 --scale=0.5",
    "still:03": "remotion still src/index.ts ReadonPromoV5 out/03-answer.png --frame=105 --scale=0.5",
    "still:04": "remotion still src/index.ts ReadonPromoV5 out/04-interest.png --frame=150 --scale=0.5",
    "still:05": "remotion still src/index.ts ReadonPromoV5 out/05-app.png --frame=210 --scale=0.5",
    "still:06": "remotion still src/index.ts ReadonPromoV5 out/06-read.png --frame=260 --scale=0.5",
    "still:07": "remotion still src/index.ts ReadonPromoV5 out/07-translation.png --frame=305 --scale=0.5",
    "still:08": "remotion still src/index.ts ReadonPromoV5 out/08-explanation.png --frame=350 --scale=0.5",
    "still:09": "remotion still src/index.ts ReadonPromoV5 out/09-close.png --frame=410 --scale=0.5",
    "stills": "npm run still:01 && npm run still:02 && npm run still:03 && npm run still:04 && npm run still:05 && npm run still:06 && npm run still:07 && npm run still:08 && npm run still:09"
  },
  "dependencies": {
    "@fontsource/biz-udpgothic": "5.3.0",
    "@fontsource/zen-kaku-gothic-new": "5.3.0",
    "@remotion/cli": "4.0.526",
    "@remotion/media": "4.0.526",
    "playwright": "1.55.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.526"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "5.8.2"
  }
}
